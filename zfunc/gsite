#!/bin/zsh

remote_url=$(git remote get-url origin 2>/dev/null) || return 1

case "$remote_url" in
  git@*:* )
    host="${remote_url#git@}"
    host="${host%%:*}"
    repo_path="${remote_url#*:}"
    site_url="https://$host/$repo_path"
    ;;
  http://* | https://* )
    site_url="$remote_url"
    ;;
  * )
    site_url="$remote_url"
    ;;
esac

print -r -- "${site_url%.git}"
